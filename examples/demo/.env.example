# The seller agent's wallet address — receives USDC payments.
SELLER_ADDRESS=0xYourSellerWalletAddressHere

# The buyer agent's wallet private key — pays for the seller's service.
# Needs a small amount of Base Sepolia ETH (gas) and test USDC.
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKeyHere

# Where the buyer sends requests. Defaults to the local seller if unset.
SELLER_BASE_URL=http://localhost:4021

# Local port the seller listens on.
PORT=4021

# Your own Anthropic API key — the seller uses this to actually do the paid
# work (real Claude calls). Get one at console.anthropic.com. Never commit
# or share this key; it's gitignored via .env already.
ANTHROPIC_API_KEY=sk-ant-...
